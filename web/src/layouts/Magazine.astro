---
// The last published page frame, verbatim: issue picker, masthead, issue menu and
// footer come from the issue's own published page, laid out by the original
// main606.css. Narrower windows get stepped overrides (see the style block).
// Rendered in the 2004 pages' quirks mode: see src/middleware.ts.
import { attrs, NEW_COMMENTS_SLOT, type Issue } from '../lib/content';
interface Props { issue: Issue; title: string; mainAttrs: string; pageCss?: string; newComments?: string | null }
const { issue, title, mainAttrs, pageCss = '', newComments } = Astro.props;
// the menu with this page's own "new comments" box (it changed with every visit)
const menu = issue.frame.menu.replace(NEW_COMMENTS_SLOT, () => newComments ?? issue.frame.newComments);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link href="/archive/main606.css" rel="stylesheet" type="text/css" />
  <style is:global set:html={issue.themeCss}></style>
  <style is:global set:html={pageCss}></style>
  <style is:global>
    /* The original is a fixed 976px layout; it is left exactly as it was whenever it fits.
       Narrower windows change only what no longer fits, in steps: */
    .menu-toggle { display: none; }
    /* 1. Under 976px: the masthead fits the window and the empty right-hand column (it held
       ads) goes; the menu and page still sit side by side as designed (792px). Touch targets
       grow without moving anything: the issue boxes and masthead links get invisible padding. */
    @media (max-width: 975px) {
      #navBar { width: auto; right: 0; }
      #content { width: auto; }
      .ad-column { display: none; }
      #issues a.issue { display: block; margin: -3px; padding: 3px; }
      #navBar a.header { padding: 12px 0; }
    }
    /* 2. Under 820px (the full masthead needs 808px from its left:121px): the issue picker,
       masthead and page stack, the issue menu folds into a button above the page, and the
       masthead and page keep their original design while they fit. The open menu drops down
       as the original 110px sidebar, with roomier lines for fingers. */
    @media (max-width: 819px) {
      body { margin: 0; }
      #issues, #navBar, #content { position: static; width: auto; height: auto; }
      #issues { padding: 6px 8px 0; text-align: left; }
      #issues table { margin: 0; width: auto; }
      #issues td.issue_true { width: 26px; height: 26px; padding: 0; }
      #issues a.issue { display: block; line-height: 26px; margin: 0; padding: 0; }
      #navBar a.header { display: inline-block; padding: 5px 0; }
      #content > table, #content > table > tbody, #content > table > tbody > tr,
      #content > table > tbody > tr > td { display: block; width: auto !important; }
      .submenu_maincell { width: auto !important; border-bottom: 1px solid #878787; }
      .submenu_maincell:not(.open) { background-image: none !important; }
      .submenu_maincell.open { background-size: 0 0; position: relative; z-index: 1; }
      .submenu_maincell > img, .submenu_maincell > table { display: none; }
      .submenu_maincell.open > img { display: block; }
      .submenu_maincell.open > table { display: table; width: 110px; background: inherit; background-size: auto; }
      /* both menu tables: the outer has an inline line-height:15px, the nested "new comments" one quirks' normal */
      .submenu_maincell.open table { line-height: 24px !important; }
      .submenu_maincell.open a { padding: 6px 0; }
      .submenu_maincell.open table table[align="right"] { float: none; margin-left: auto; width: auto; }
      .menu-toggle { display: block; width: 100%; padding: 8px; border: 0; background: none; text-align: left;
                     font: bold 13px/15px Arial, sans-serif; color: #000; cursor: pointer; }
      .menu-toggle::after { content: " \25BE"; content: " \25BE" / ""; }
      .submenu_maincell.open > .menu-toggle::after { content: " \25B4"; content: " \25B4" / ""; }
      #content > table > tbody > tr > td.main_cell_margin { width: 682px !important; margin: 0 auto; }
    }
    /* 3. Phones (under 690px), where the 682px page can't fit: the masthead's links wrap under
       a smaller logo, and the page reflows into one column (tables stack, nudged offsets drop,
       images scale) while rows of small cells (thumbnails, pagers, arrows) stay side by side. */
    @media (max-width: 689px) {
      #navBar table { width: 100%; }
      #navBar td { display: inline-block; vertical-align: bottom; }
      #navBar img[src*="header_deviders"], #navBar img[src*="header_left"] { display: none; }
      #navBar .header_border_middle img { max-width: 60vw; height: auto; }
      #navBar .header_border, #navBar .header_border_middle { border: 0; }
      #navBar > table { background-size: cover; border-bottom: 1px solid #878787; }
      #content > table > tbody > tr > td.main_cell_margin { width: auto !important; margin: 0; padding: 8px; border-right: 0 !important; }
      .main_cell_margin img { max-width: 100%; height: auto; }
      /* column dividers (and issue 6's stretched side_bar spacer) mean nothing once the columns stack */
      .main_cell_margin img:is([src$="index/images/side_bar.gif"], [src$="fcc/images/vert_line.gif"], [src$="steam/images/bkg_br.gif"], [src$="3rdcoast/images/bar.gif"], [src$="bungalow/images/line.gif"]) { display: none; }
      .main_cell_margin table, .main_cell_margin tbody, .main_cell_margin tr, .main_cell_margin td {
        display: block; width: auto !important; max-width: 100%; }
      .main_cell_margin * { position: static !important; max-width: 100%; box-sizing: border-box; }
      .main_cell_margin [style*="width"], .main_cell_margin div { width: auto !important; }
      /* boxes sized for the 682px layout: let them grow with the reflowed text instead of spilling over */
      .main_cell_margin *:not(img) { height: auto !important; }
      /* long unbroken URLs (the "More info: http://..." lines closing the 30-under-30 profiles) wrap;
         only a cell's last paragraph, since break-word splits words beside floated photos */
      .main_cell_margin td > p:last-child { overflow-wrap: break-word; }
      /* the issue 5 "no place like home" photo grid is ~130px wide: it stays a grid */
      .main_cell_margin table.out_border { display: table; }
      .main_cell_margin .out_border tbody { display: table-row-group; }
      .main_cell_margin .out_border tr { display: table-row; }
      .main_cell_margin .out_border td { display: table-cell; }
      /* covers 9-12: each feature photo stays above its own caption plate */
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) { display: flex; flex-direction: column; align-items: center; }
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) > tbody,
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) > tbody > tr { display: contents; }
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) td:nth-child(2n) { display: none; }
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) td:nth-child(3) { order: 1; }
      .main_cell_margin table:has(> tbody > tr > td.feat_marg) td:nth-child(5) { order: 2; }
      .main_cell_margin td.feat_marg { margin-bottom: 16px; }
      /* touch: links standing alone in a cell (number pagers, prev/next) get a larger tap area to the
         right and below; the margin cancels the padding, so nothing shifts */
      .main_cell_margin td:not(:has(> :not(a))) > a:not(:has(img)) { padding: 0 6px 6px 0; margin-right: -6px; }
      #footer { left: 0; width: auto; }
      /* rows of small cells (thumbnail strips, 1-10 pagers, prev/next) sit side by side again and wrap;
         not the Gorey A-Z list, a column's first link next to a rowspan cell, or bare images in a floated table */
      .main_cell_margin td:where(:not(:only-child):is(:has(> a:only-child), :has(> img:only-child)):not(:has(img[src*="photo_gorey/images/menu/"]), tr:has(> [rowspan]) > :has(> a:only-child), :is(table[align="left"], table[align="right"]) > * > tr > :has(> img:only-child))) {
        display: inline-block; vertical-align: top; min-width: 24px; }
      /* side-by-side text links ("back to page 1" / "go to page 3") keep a visible gap */
      .main_cell_margin td:where(:not(:only-child):has(> a:only-child):not(:has(> a img))) { padding-left: .4em; padding-right: .4em; }
    }
  </style>
  <script is:inline>
    // Dreamweaver helpers the 2004 pages call (rollovers, popups).
    function MM_preloadImages(){var d=document;if(d.images){if(!d.MM_p)d.MM_p=[];var i,j=d.MM_p.length,a=arguments;for(i=0;i<a.length;i++)if(a[i].indexOf('#')!=0){d.MM_p[j]=new Image;d.MM_p[j++].src=a[i];}}}
    function MM_swapImgRestore(){var i,x,a=document.MM_sr;for(i=0;a&&i<a.length&&(x=a[i])&&x.oSrc;i++)x.src=x.oSrc;}
    function MM_findObj(n,d){var x;if(!d)d=document;if(!(x=d[n])&&d.all)x=d.all[n];if(!x&&d.getElementById)x=d.getElementById(n);for(var i=0;!x&&d.forms&&i<d.forms.length;i++)x=d.forms[i][n];return x;}
    function MM_swapImage(){var i,j=0,x,a=arguments;document.MM_sr=[];for(i=0;i<(a.length-2);i+=3)if((x=MM_findObj(a[i]))!=null){document.MM_sr[j++]=x;if(!x.oSrc)x.oSrc=x.src;x.src=a[i+2];}}
    function MM_openBrWindow(u,n,f){window.open(u,n,f);}
  </script>
</head>
<body>
  <Fragment set:html={issue.frame.issues} />
  <Fragment set:html={issue.frame.nav} />
  <div id="content">
    <table border="0" cellpadding="0" cellspacing="0">
      <tr>
        <td {...attrs('width="110" align="left" valign="top"')} class="submenu_maincell">
          <button class="menu-toggle" type="button" aria-expanded="false"
                  onclick="var c=this.parentNode;c.classList.toggle('open');this.setAttribute('aria-expanded',c.classList.contains('open'))">issue {issue.number} contents</button>
          <Fragment set:html={menu} />
        </td>
        <td {...attrs(mainAttrs)}>
          <slot />
          <Fragment set:html={issue.frame.footer} />
        </td>
        <td {...attrs('width="180" align="center" valign="top"')} class="ad-column">&nbsp;</td>
      </tr>
    </table>
    <br />
  </div>
</body>
</html>
