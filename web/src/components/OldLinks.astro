---
// The old-link redirect page (2004 addresses: main.php?id=…, issue_id, index.vN.php, old file
// names) translated to their rebuilt or archive address. Served as the 404 page for every
// unknown address, and also at /main.php/, /index.php/ and /index.vN.php/ (pages/[old]/), so
// the most common old links get a normal answer that search engines follow, not a 404.
// Works under ryanmarshall.github.io/606mag/ and under 606mag.com/.
// Article and issue links (main.php?id=…, issue_id, index.vN.php) resolve from a 22 KB map
// carried in the page, so the redirect fires at once (search engines snapshot slow redirects
// as near-empty "soft 404" pages); only other old addresses fetch the full map (redirects.json).
import HeadTags from './HeadTags.astro';
import redirects from '../../public/redirects.json';
const quick = JSON.stringify({ articles: redirects.articles, issues: redirects.issues }).replaceAll('<', '\\u003c');
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <HeadTags pageView={false} />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>sixosix magazine chicago</title>
  <style>
    body { font: 12px Arial, Verdana, sans-serif; color: #707171; background: #fff; margin: 80px 16px; text-align: center; }
    a { color: #6C7393; text-decoration: none; }
    a:hover { color: #878787; }
    #notfound { display: none; }
  </style>
</head>
<body>
  <p id="moving">one moment&hellip;</p>
  <div id="notfound">
    <p>that page isn&rsquo;t here anymore.</p>
    <p><a id="home" href="/">sixosix magazine &rarr;</a></p>
  </div>
  <script type="application/json" id="old-links" set:html={quick} />
  <script is:inline>
    (function () {
      var path = location.pathname;
      var base = path.indexOf('/606mag/') === 0 ? '/606mag/' : '/';
      var rest = path.slice(base.length);
      try { rest = decodeURIComponent(rest); } catch (e) {}
      document.getElementById('home').href = base;
      // Same canonical form as the build: drop session ids and "amp;" key prefixes, sort,
      // and encode like Python's urlencode (space as "+", only A-Z a-z 0-9 _ . - ~ kept).
      var enc = function (s) {
        return encodeURIComponent(s).replace(/[!'()*]/g, function (c) {
          return '%' + c.charCodeAt(0).toString(16).toUpperCase();
        }).replace(/%20/g, '+');
      };
      var pairs = [];
      new URLSearchParams(location.search).forEach(function (v, k) {
        k = k.replace(/^(amp;)+/, '');
        if (k && k.toLowerCase() !== 'phpsessid') pairs.push([k, v]);
      });
      pairs.sort(function (a, b) { return a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : a[1] < b[1] ? -1 : a[1] > b[1] ? 1 : 0; });
      var get = function (k) { for (var i = 0; i < pairs.length; i++) if (pairs[i][0] === k) return pairs[i][1]; return null; };
      var query = pairs.map(function (p) { return enc(p[0]) + '=' + enc(p[1]); }).join('&');
      // the page a visitor is sent on to reports their real referrer (components/HeadTags.astro)
      var go = function (target) {
        // a note from the front door ("<time> <referrer>") is kept if fresh, else this visit's own referrer
        try { var v = sessionStorage.getItem('606.ref'); v = v && Date.now() - parseInt(v, 10) < 30000 ? Date.now() + v.slice(v.indexOf(' ')) : Date.now() + ' ' + document.referrer; sessionStorage.setItem('606.ref', v); } catch (e) {}
        location.replace(base + target + location.hash);
      };
      var notFound = function () {
        if (window.gtag) gtag('event', 'page_view', { page_title: 'not found' });   // dead old links show up in Analytics
        // not a page to index (it answers 200 at /main.php/ and the like)
        var m = document.createElement('meta'); m.name = 'robots'; m.content = 'noindex'; document.head.appendChild(m);
        try { sessionStorage.removeItem('606.ref'); } catch (e) {}
        document.getElementById('moving').style.display = 'none';
        document.getElementById('notfound').style.display = 'block';
      };
      // own entries only (an address like ?id=constructor must not match a built-in name)
      var own = function (o, k) { return k !== null && o && Object.prototype.hasOwnProperty.call(o, k) ? o[k] : undefined; };
      // false: the address needs the full map (map.archive), fetched below
      var route = function (map) {
        var file = rest.replace(/\/+$/, '');
        var cover = /^index\.v(\d+)\.php$/.exec(file);
        if (cover && own(map.issues, cover[1])) return go(own(map.issues, cover[1]));
        if (file === 'main.php' || file === '' || file === 'index.php') {
          var id = get('id'), issue = get('issue_id');
          if (own(map.articles, id)) {
            var a = own(map.articles, id);
            var key = pairs.filter(function (p) {
              return p[0] !== 'id' && !(p[0] === 'page' && (p[1] === 'index' || p[1] === ''));
            }).map(function (p) { return enc(p[0]) + '=' + enc(p[1]); }).join('&');
            return go(a.base + (own(a.pages, key) !== undefined ? own(a.pages, key) : ''));
          }
          if (own(map.issues, issue)) return go(own(map.issues, issue));
          if (!query) return go('');
          if (!map.archive) return false;
          // a section page: the exact page, its old root-alias form, else the section's index
          // (alias entries that point at the homepage don't count as a match)
          var gen = get('general');
          var tries = ['/' + file + '?' + query, '/main.php?' + query, '/?' + query];
          if (gen) ['general=' + enc(gen) + '&page=index', 'general=' + enc(gen)].forEach(function (q) {
            tries.push('/main.php?' + q, '/?' + q);
          });
          for (var t = 0; t < tries.length; t++) {
            var h = own(map.archive, tries[t]);
            if (h && h !== 'main.html') return go('archive/' + h);
          }
          return go('');
        }
        if (!map.archive) return false;
        var hit = own(map.archive, '/' + rest + (query ? '?' + query : '')) || own(map.archive, '/' + rest);
        if (hit) return go('archive/' + hit);
        notFound();
      };
      var quick = {};
      try { quick = JSON.parse(document.getElementById('old-links').textContent); } catch (e) {}
      if (route(quick) === false) {
        fetch(base + 'redirects.json').then(function (r) { return r.json(); }).then(route).catch(notFound);
      }
    })();
  </script>
</body>
</html>
